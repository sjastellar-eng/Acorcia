// ─────────────────────────────────────────────────────────────
// Source Constructor — Prisma Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────

enum UserPlan {
  free
  pro
  annual
}

enum UserRole {
  user
  admin
}

enum SessionStatus {
  in_progress
  completed
  abandoned
}

enum SessionType {
  open_discovery
  focused
}

enum SessionPhase {
  context
  values
  desires
  constraints
  synthesis
  complete
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum PhaseStatus {
  not_started
  in_progress
  completed
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  in_progress
  done
  skipped
}

enum CheckinTaskResult {
  done
  partial
  missed
  skipped
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
}

// ── USER ─────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  name                  String?
  avatarUrl             String?
  plan                  UserPlan  @default(free)
  role                  UserRole  @default(user)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  emailVerified         Boolean   @default(false)
  emailVerifiedAt       DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions              DiscoverySession[]
  projects              Project[]
  checkins              DailyCheckin[]
  insights              UserInsight[]
  notifications         NotificationPreference?
  subscription          Subscription?
  refreshTokens         RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ── DISCOVERY SESSION ────────────────────────────────────────

model DiscoverySession {
  id                String        @id @default(cuid())
  userId            String
  title             String?
  type              SessionType   @default(open_discovery)
  status            SessionStatus @default(in_progress)
  currentPhase      SessionPhase  @default(context)
  focusQuestion     String?
  summary           String?       @db.Text
  encryptedSummary  String?       @db.Text
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  durationMinutes   Int?
  messageCount      Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          SessionMessage[]
  insights          SessionInsight[]
  projects          Project[]

  @@index([userId])
  @@map("discovery_sessions")
}

model SessionMessage {
  id          String       @id @default(cuid())
  sessionId   String
  role        String       // 'user' | 'assistant'
  content     String       @db.Text
  phase       SessionPhase
  tokenCount  Int?
  createdAt   DateTime     @default(now())

  session     DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_messages")
}

model SessionInsight {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  content     String   @db.Text
  theme       String?
  importance  Int      @default(3)
  embedding   Bytes?
  createdAt   DateTime @default(now())

  session     DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("session_insights")
}

// ── PROJECT ───────────────────────────────────────────────────

model Project {
  id                      String        @id @default(cuid())
  userId                  String
  sessionId               String?
  name                    String
  tagline                 String?
  description             String?       @db.Text
  targetUser              String?       @db.Text
  monetizationModel       String?       @db.Text
  timeCommitmentWeekly    Int?
  timelineWeeks           Int?
  status                  ProjectStatus @default(active)
  progressPercent         Int           @default(0)
  currentStreak           Int           @default(0)
  longestStreak           Int           @default(0)
  lastCheckinAt           DateTime?
  isPublic                Boolean       @default(false)
  publicSlug              String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session                 DiscoverySession? @relation(fields: [sessionId], references: [id])
  phases                  ProjectPhase[]
  tasks                   Task[]
  checkins                DailyCheckin[]
  insights                ProjectInsight[]

  @@index([userId])
  @@map("projects")
}

model ProjectPhase {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  description String?     @db.Text
  orderIndex  Int
  status      PhaseStatus @default(not_started)
  startWeek   Int
  endWeek     Int
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  tasks       Task[]

  @@index([projectId])
  @@map("project_phases")
}

model Milestone {
  id          String    @id @default(cuid())
  phaseId     String
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  orderIndex  Int
  createdAt   DateTime  @default(now())

  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@index([projectId])
  @@map("milestones")
}

model Task {
  id            String       @id @default(cuid())
  projectId     String
  phaseId       String?
  title         String
  description   String?      @db.Text
  priority      TaskPriority @default(medium)
  status        TaskStatus   @default(todo)
  dueDate       DateTime?
  completedAt   DateTime?
  orderIndex    Int          @default(0)
  isAiSuggested Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         ProjectPhase? @relation(fields: [phaseId], references: [id])
  checkins      DailyCheckin[] @relation("CommittedTask")
  nextCheckins  DailyCheckin[] @relation("NextTask")

  @@index([projectId])
  @@map("tasks")
}

model ProjectInsight {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String   @db.Text
  source    String   // 'session' | 'checkin' | 'pattern_detection'
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_insights")
}

// ── DAILY CHECK-IN ─────────────────────────────────────────────

model DailyCheckin {
  id                  String            @id @default(cuid())
  userId              String
  projectId           String
  date                DateTime          @db.Date
  taskCommittedId     String?
  taskCommittedTitle  String?
  taskResult          CheckinTaskResult?
  taskResultNote      String?           @db.Text
  aiResponse          String?           @db.Text
  nextTaskId          String?
  nextTaskTitle       String?
  blockerMentioned    String?           @db.Text
  moodScore           Int?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  committedTask       Task?             @relation("CommittedTask", fields: [taskCommittedId], references: [id])
  nextTask            Task?             @relation("NextTask", fields: [nextTaskId], references: [id])

  @@unique([userId, projectId, date])
  @@index([userId])
  @@index([projectId])
  @@map("daily_checkins")
}

// ── USER INSIGHTS ──────────────────────────────────────────────

model UserInsight {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  theme     String?
  source    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_insights")
}

// ── BILLING ────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  plan                 UserPlan
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEnd             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ── NOTIFICATIONS ─────────────────────────────────────────────

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  checkinTime     String   @default("09:00") // HH:MM
  timezone        String   @default("UTC")
  emailCheckin    Boolean  @default(true)
  emailWeekly     Boolean  @default(true)
  pushEnabled     Boolean  @default(false)
  checkinDays     String   @default("1,2,3,4,5,6,7") // 1=Mon..7=Sun
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
